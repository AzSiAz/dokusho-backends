  "db_name": "PostgreSQL",
  "query": "\n            INSERT INTO users (sub, email, name, role)\n            VALUES ($1, $2, $3, $4)\n            ON CONFLICT (sub) DO UPDATE\n            SET email = COALESCE($2, users.email),\n                name = COALESCE($3, users.name),\n                role = $4,\n                updated_at = NOW()\n            RETURNING id, sub, email, name, role as \"role: UserRole\", created_at, updated_at\n            ",
