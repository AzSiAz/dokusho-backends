  "query": "\n            INSERT INTO \"user\" (sub, email, name, role, created_at, updated_at)\n            VALUES ($1, $2, $3, $4, $5, $6)\n            ON CONFLICT (sub) \n            DO UPDATE SET \n                email = COALESCE($2, \"user\".email),\n                name = COALESCE($3, \"user\".name),\n                role = $4,\n                updated_at = $6\n            RETURNING \n                id, \n                sub, \n                email, \n                name, \n                created_at, \n                updated_at, \n                role as \"role: UserRole\"\n            ",
