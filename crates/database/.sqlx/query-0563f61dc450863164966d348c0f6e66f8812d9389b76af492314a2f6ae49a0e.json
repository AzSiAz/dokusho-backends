  "query": "\n            INSERT INTO users (sub, email, name)\n            VALUES ($1, $2, $3)\n            ON CONFLICT (sub) DO UPDATE\n            SET email = COALESCE($2, users.email),\n                name = COALESCE($3, users.name),\n                updated_at = NOW()\n            RETURNING id, sub, email, name, created_at, updated_at\n            ",
